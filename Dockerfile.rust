# Rust Implementation Dockerfile
FROM rust:1.75-slim

# Set environment variables
ENV RUST_BACKTRACE=1
ENV CARGO_REGISTRIES_CRATES_IO_PROTOCOL=sparse

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy Rust dependencies
COPY Cargo.toml Cargo.lock ./
COPY rust/Cargo.toml ./rust/
COPY src/ ./src/

# Build Rust CLI in release mode
RUN cargo build --release --manifest-path rust/Cargo.toml --target-dir rust/target
RUN cp rust/target/release/whitespace-stego-rs /usr/local/bin/

# Copy source code for reference
COPY rust/ ./rust/
COPY src/ ./src/

# Create data directory
RUN mkdir -p /app/data

# Create convenience script
RUN echo '#!/bin/bash\n\
echo "=== Rust Whitespace Steganography ==="\n\
echo "Available commands:"\n\
echo "  CLI: whitespace-stego-rs --help"\n\
echo "  Encode: whitespace-stego-rs encode --help"\n\
echo "  Decode: whitespace-stego-rs decode --help"\n\
echo ""\n\
echo "Examples:"\n\
echo "  whitespace-stego-rs encode --mf message.txt --cf carrier.txt -o encoded.txt"\n\
echo "  whitespace-stego-rs decode --cf encoded.txt -o decoded.txt"\n\
echo "  whitespace-stego-rs encode -m \"Secret message\" -c \"Hello world\" -o encoded.txt"\n\
' > /usr/local/bin/rust-stego-help && chmod +x /usr/local/bin/rust-stego-help

# Default command
CMD ["rust-stego-help"] 